# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tradebot_db?retryWrites=true&w=majority
DATABASE_NAME=tradebot_db

# Security
SECRET_KEY=tradebot-production-jwt-secret-key-nse-super-secure-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Market Data & Scanner
MARKET_DATA_PROVIDER=yfinance
SCANNER_INTERVAL_SECONDS=60

# Risk Management Defaults
DEFAULT_CAPITAL=1000000.0
RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_LOSS=20000.0
